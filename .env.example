# Copy to .env (never commit real secrets)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ajocredit
REDIS_URL=redis://localhost:6379
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
TERMII_API_KEY=YOUR_LIVE_TERMII_KEY_HERE
TERMII_SENDER_ID=OE Alert
TERMII_CHANNEL=dnd
TERMII_BASE_URL=https://v4.api.termii.com
# termii = Termii generates the code and its Verify API validates it.
# local  = we generate the code ourselves and validate our salted hash (use when
#          the Termii OTP/Verify product is inactive on the account).
TERMII_OTP_MODE=termii
# Web-bundle updates (Capacitor Updater). ROLLOUT is the percentage of devices
# that get the new bundle (0-100). It starts at 5 - a small slice first, then
# 25 -> 50 -> 100 once the new bundle has been seen to work.
# ROLLBACK=1 hands every device the last known good bundle instead of the new one.
APP_UPDATE_ROLLOUT=5
APP_UPDATE_ROLLBACK=0
APP_BUNDLE_MANIFEST=https://kingpriest001.github.io/ajocredit-prd/bundle.json
# Lock the API: only a signed-in member can call the group / money routes.
# 0 = pilot (open), 1 = production (locked).
REQUIRE_AUTH=0
# The agent admin panel (/admin/agents.html) stays switched off until this is
# set. The panel sends it as the x-admin-token header.
AGENT_ADMIN_TOKEN=change-me-to-a-long-random-string
# The public site that hosts the agent pages (used in the WhatsApp links).
AGENT_SITE_URL=https://ajocredit.pages.dev
# Transactional email (welcome and password reset). Without these the emails are
# recorded in email_log but not delivered.
RESEND_API_KEY=xxx
RESEND_FROM=AJOCREDIT <no-reply@ajocredit.app>
AFRICASTALKING_API_KEY=xxx
S3_ENDPOINT=https://xxx
S3_BUCKET=ajocredit-evidence
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
PAYOUT_BATCH_CRON_1=0 10 * * *
PAYOUT_BATCH_CRON_2=0 15 * * *
